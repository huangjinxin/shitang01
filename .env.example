# PostgreSQL 连接串（本地开发示例）
# 请复制本文件为 .env 并按本机实际情况修改用户名/密码/库名。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_canteen?schema=public"

# 数据模式：auto=优先连接数据库，连不上则进入明确标注的只读演示模式；
# db=仅数据库模式（连不上直接报错）；demo=强制演示模式。
DATA_MODE="auto"

# 导入原始文件保存目录（相对项目根目录）
IMPORT_UPLOAD_DIR="var/uploads"

# 默认操作者名称（MVP 阶段无登录体系，用于记录操作日志）
DEFAULT_ACTOR="本地用户"
